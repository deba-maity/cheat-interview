# Copy to .env beside the portable .exe (or in the project root for development).
# Your own keys are reloaded at launch or through Settings > Reload keys.
# Nonempty file keys override saved keys for that provider. Alternatively use Settings.
# Keep this file without real keys. Never commit .env or bundle it into a build.

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: rotate among your own credentials. Comma-separated _API_KEYS
# takes precedence over the matching single _API_KEY.
# GROQ_API_KEYS=first-key,second-key

AI_PROVIDER_ORDER=groq,gemini,openai,openrouter
AI_TIMEOUT_MS=18000
AI_BUDGET_MS=90000
AI_MAX_ATTEMPTS=12

GROQ_TEXT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODELS=whisper-large-v3-turbo,whisper-large-v3
OPENAI_TEXT_MODELS=gpt-4o-mini,gpt-4.1-mini
OPENAI_VISION_MODELS=gpt-4o-mini,gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODELS=gpt-4o-mini-transcribe,whisper-1
GEMINI_TEXT_MODELS=gemini-3.8-flash,gemini-2.5-flash
GEMINI_VISION_MODELS=gemini-3.8-flash,gemini-2.5-flash
OPENROUTER_TEXT_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash
OPENROUTER_VISION_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash

# Optional development server only. Not needed by the desktop app.
LOCAL_API_TOKEN=
PORT=3001
