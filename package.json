{
  "name": "stealth-overlay-app",
  "version": "1.0.0",
  "main": "main.js",
  "dependencies": {
    "dotenv": "^17.2.1",
    "tesseract.js": "^6.0.1"
  },
  "gypfile": false,
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "prestart": "node scripts/check-node.js",
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/smoke-test.js",
    "test:ocr": "node scripts/check-ocr.js",
    "build": "node scripts/build-windows.js",
    "dist": "node scripts/build-windows.js",
    "rebuild:native": "npx node-gyp rebuild",
    "test:package": "node scripts/check-package.js"
  },
  "build": {
    "appId": "com.faks.stealthoverlay",
    "productName": "Stealth Overlay",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "audio-capture.js",
      "index.html",
      "styles.css",
      "lib/**",
      "assets/**",
      "package.json",
      "node_modules/**",
      "!.env",
      "!.env.*",
      "!**/*.enc"
    ],
    "extraResources": [
      {
        "from": "eng.traineddata",
        "to": "lang/eng.traineddata"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "electronLanguages": ["en-US"],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Stealth Overlay.exe",
      "requestExecutionLevel": "user"
    },
    "asarUnpack": [
      "node_modules/**"
    ],
    "npmRebuild": false
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12"
  },
  "description": "Desktop meeting and coding assistant with speech, screen reading, and multi-provider failover.",
  "optionalDependencies": {
    "node-addon-api": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
